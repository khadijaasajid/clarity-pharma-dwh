{
  "dashboard": {
    "title": "Storage Dashboard",
    "tags": ["clarity-pharma", "storage"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Row Counts by Table (Staging)",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
        "datasource": {"type": "postgres", "uid": "${DS_POSTGRESQL_STAGING}"},
        "targets": [{
          "rawSql": "SELECT \"TableName\", \"RowCount\" FROM storage_metrics WHERE \"Layer\" = 'Staging (PostgreSQL)' AND \"MeasuredAt\" = (SELECT MAX(\"MeasuredAt\") FROM storage_metrics) ORDER BY \"RowCount\" DESC",
          "format": "table",
          "refId": "A"
        }]
      },
      {
        "id": 2,
        "title": "Row Counts by Table (DuckDB OLAP)",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
        "datasource": {"type": "postgres", "uid": "${DS_POSTGRESQL_STAGING}"},
        "targets": [{
          "rawSql": "SELECT \"TableName\", \"RowCount\" FROM storage_metrics WHERE \"Layer\" = 'OLAP (DuckDB)' AND \"MeasuredAt\" = (SELECT MAX(\"MeasuredAt\") FROM storage_metrics) ORDER BY \"RowCount\" DESC",
          "format": "table",
          "refId": "A"
        }]
      },
      {
        "id": 3,
        "title": "Storage Size (MB) by Staging Table",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
        "datasource": {"type": "postgres", "uid": "${DS_POSTGRESQL_STAGING}"},
        "targets": [{
          "rawSql": "SELECT \"TableName\", \"SizeMB\" FROM storage_metrics WHERE \"Layer\" = 'Staging (PostgreSQL)' AND \"SizeMB\" > 0 AND \"MeasuredAt\" = (SELECT MAX(\"MeasuredAt\") FROM storage_metrics) ORDER BY \"SizeMB\" DESC",
          "format": "table",
          "refId": "A"
        }]
      },
      {
        "id": 4,
        "title": "Row Count Growth Over Batches",
        "type": "barchart",
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
        "datasource": {"type": "postgres", "uid": "${DS_POSTGRESQL_STAGING}"},
        "targets": [{
          "rawSql": "SELECT \"BatchFolder\", \"TableName\", \"RowCount\" FROM storage_metrics WHERE \"Layer\" = 'Staging (PostgreSQL)' ORDER BY \"MeasuredAt\"",
          "format": "table",
          "refId": "A"
        }]
      },
      {
        "id": 5,
        "title": "Full Storage Metrics",
        "type": "table",
        "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
        "datasource": {"type": "postgres", "uid": "${DS_POSTGRESQL_STAGING}"},
        "targets": [{
          "rawSql": "SELECT \"Layer\", \"TableName\", \"RowCount\", \"SizeMB\", \"BatchFolder\", \"MeasuredAt\" FROM storage_metrics ORDER BY \"MeasuredAt\" DESC, \"RowCount\" DESC",
          "format": "table",
          "refId": "A"
        }]
      }
    ],
    "schemaVersion": 38,
    "version": 1
  },
  "overwrite": true
}